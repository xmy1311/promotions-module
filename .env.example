# ---------------------------------------------------------------------------
# Copiar a .env y completar. NUNCA versionar el archivo .env con valores reales.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Único secreto del proyecto -------------------------------------------
# Contraseña del usuario 'sa' de SQL Server.
# Requisitos de SQL Server: minimo 8 caracteres, con mayusculas, minusculas,
# numeros y simbolos. Si no cumple, el contenedor de la base de datos no arranca.
# En CI se inyecta desde GitHub Secrets (secrets.MSSQL_SA_PASSWORD).
MSSQL_SA_PASSWORD=

# --- Conexión a base de datos ---------------------------------------------
# DB_HOST es el nombre del servicio de docker-compose. Para ejecutar el backend
# fuera de Docker contra la base dockerizada, usar localhost.
DB_HOST=db
DB_PORT=1433
DB_NAME=promotions
DB_USER=sa
# Credencial que usa la aplicación. En docker-compose se deriva automáticamente
# de MSSQL_SA_PASSWORD para no duplicar el secreto; solo hace falta rellenarla
# aquí si ejecutas el backend fuera de Docker (modo desarrollo).
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MAX=10

# --- Aplicación ------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Zona horaria de negocio. Define qué día es "hoy" para el cálculo de vigencia.
# NO depende del reloj del contenedor ni del navegador.
APP_TIMEZONE=America/Bogota

# Orígenes permitidos por CORS, separados por coma. Vacío = ninguno.
# En docker-compose el frontend usa proxy inverso, así que no necesita CORS.
CORS_ORIGINS=http://localhost:5173

# Tiempo máximo que /health espera a la base de datos antes de declararla caída.
HEALTH_DB_TIMEOUT_MS=2000

# --- Puertos publicados en el host ----------------------------------------
FRONTEND_PORT=5173
BACKEND_PORT=3000
DB_PORT_HOST=1433
